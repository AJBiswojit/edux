APP_NAME=MediXO EduX API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/v1
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256

# PostgreSQL (production). For local without Docker, sqlite:///./medixo.db also works.
# Shared RDS: point at the database, then pin objects to schema edux only.
DATABASE_URL=postgresql+psycopg2://medixo:medixo@localhost:5432/medixo_edux
DB_SCHEMA=edux
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI platform — leave empty to use deterministic fallback (same honesty as the SPA prototype)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
AI_MAX_TOKENS=2048

PARENT_PORTAL_ENABLED=false
SEED_DEMO_USERS=true
DEMO_PASSWORD=aurora123

LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10
