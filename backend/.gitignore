# EduX backend ignore rules
# Python bytecode and native extensions
__pycache__/
*.py[cod]
*$py.class
*.so
# Virtual environments
.venv/
venv/
env/
ENV/
# Environment files and secrets
.env
.env.*
!.env.example
!.env.template
# Local database files
*.db
*.sqlite
*.sqlite3
*.db-journal
# Logs
*.log
logs/
# Testing and coverage caches
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
# Type-checking and linting caches
.mypy_cache/
.pyright/
.ruff_cache/
# Build and package artifacts
build/
dist/
*.egg-info/
.eggs/
# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
# Operating system metadata
.DS_Store
Thumbs.db
desktop.ini
# Temporary files
*.tmp
*.temp
*.bak
*.cache